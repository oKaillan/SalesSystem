@inject BaseApiService<GetProductDto> prodApi

<div class="table-container">
    <table>
        <thead>
            <tr>
                <th></th>
                <th>
                    <input class="search-input"
                           type="search"
                           @onchange="OnIdChanged"
                           placeholder="iD" />
                </th>
                <th>
                    <input class="search-input"
                           type="search"
                           @onchange="e => OnNameChanged(e.Value?.ToString())"
                           placeholder="Insert Product Name" />
                </th>
                <th></th>
                <th></th>
                <th>
                    <select @onchange="OnCategoryChanged">
                        <option value="">Select Category</option>
                        @foreach (var category in Category!.Data)
                        {
                            <option value="@category.id">@category.name</option>
                        }
                    </select>
                </th>
            </tr>
            <tr>
                <th class="add-field"></th>
                @*ID FIELD*@
                <th class="id-field">
                    <div class="th-content">
                        <span>
                            iD
                            <a @onclick="() => Filtering(ProductOrderByFilter.id)">
                                <img @onclick="ToggleRotate"
                                     class="arrow-down rotate @(_filter.OrderBy == ProductOrderByFilter.id
                                                                             ? (_filter.Descending ? "desc" : "asc") : "" )"
                                     src="/img/svg/angle-down-solid-full.svg"
                                     alt="arrow-down" />
                            </a>
                        </span>
                    </div>
                </th>

                @*NAME FIELD*@
                <th class="name-field">
                    <div class="th-content">
                        <span>
                            Name
                            <a @onclick="() => Filtering(ProductOrderByFilter.name)">
                                <img @onclick="ToggleRotate"
                                     class="arrow-down rotate @(_filter.OrderBy == ProductOrderByFilter.name ? (_filter.Descending ? "desc" : "asc") : "")"
                                     src="/img/svg/angle-down-solid-full.svg"
                                     alt="arrow-down" />
                            </a>
                        </span>
                    </div>
                </th>

                @*QUANTITY FIELD*@
                <th class="qtd-field">
                    <div class="th-content">
                        <span>
                            Quantity
                            <a @onclick="() => Filtering(ProductOrderByFilter.quantity)">
                                <img @onclick="ToggleRotate"
                                     class="arrow-down rotate @(_filter.OrderBy == ProductOrderByFilter.quantity ? (_filter.Descending ? "desc" : "asc") : "")"
                                     src="/img/svg/angle-down-solid-full.svg"
                                     alt="arrow-down" />
                            </a>
                        </span>
                    </div>
                </th>

                @*PRICE FIELD*@
                <th class="price-field">
                    <div class="th-content">
                        <span>
                            Price
                            <a @onclick="() => Filtering(ProductOrderByFilter.price)">
                                <img @onclick="ToggleRotate"
                                     class="arrow-down rotate @(_filter.OrderBy == ProductOrderByFilter.price ? (_filter.Descending ? "desc" : "asc") : "")"
                                     src="/img/svg/angle-down-solid-full.svg"
                                     alt="arrow-down" />
                            </a>
                        </span>
                    </div>
                </th>

                @*CATEGORY FIELD*@
                <th class="category-field">
                    <div class="th-content">
                        <span>
                            Categories
                            <a @onclick="() => Filtering(ProductOrderByFilter.category)">
                                <img @onclick="ToggleRotate" class="arrow-down rotate @(_filter.OrderBy == ProductOrderByFilter.category ? (_filter.Descending ? "desc" : "asc") : "")"
                                     src="/img/svg/angle-down-solid-full.svg"
                                     alt="arrow-down" />
                            </a>
                        </span>
                    </div>
                </th>
            </tr>
        </thead>

        <tbody>
            @if (Product?.Data.Count == 0)
            {
                <tr>
                    <td colspan="6"> @*Columns quantity*@
                        <h1 style="text-align: center">Product not Found</h1>
                    </td>
                </tr>
            }
            else
            {

                @foreach (var product in Product!.Data)
                {
                    <tr>
                        <td class="add-field">
                            <a class="add-button" href="/">
                                <svg class="add-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640">
                                    <path d="M352 128C352 110.3 337.7 96 320 96C302.3 96 288 110.3 288 128L288 288L128 288C110.3 288 96 302.3 96 320C96 337.7 110.3 352 128 352L288 352L288 512C288 529.7 302.3 544 320 544C337.7 544 352 529.7 352 512L352 352L512 352C529.7 352 544 337.7 544 320C544 302.3 529.7 288 512 288L352 288L352 128z" />
                                </svg>
                            </a>
                        </td>
                        <td class="id-field">@product.iD</td>
                        <td class="name-field">@product.name</td>
                        <td class="qtd-field">@product.quantity</td>
                        <td class="price-field">@String.Format($"{product.price:C}")</td>
                        <td class="category-field">
                            @*Separates Categories using ,*@
                            @string.Join(", ", product.categories!.Select(p => p.name))
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
    <div class="arrow-button-field">
        <img id="left-arrow" src="/img/svg/arrow-button.svg"
             @onclick="Product.PreviousPageAsync" />
        <input id="page-counter" type="number"
               value="@Product.PageNumber"
               @onchange="Product.GoToPageNumberAsync" />
        <img id="right-arrow" src="/img/svg/arrow-button.svg"
             @onclick="Product.NextPageAsync" />
    </div>

</div>

@code {
    [Parameter]
    public PaginationService<GetProductDto, ProductOrderByFilter>? Product { get; set; }
    [Parameter]
    public PagedResult<GetCategoryDto>? Category { get; set; }
    private ProductFilterDto _filter = new();
    private bool isRotated;

    private async Task OnIdChanged(ChangeEventArgs e)
    {
        var value = e.Value?.ToString();

        if (string.IsNullOrWhiteSpace(value))
        {
            await Product!.ResetAsync();
            return;
        }

        if (int.TryParse(value, out int id))
        {
            var result = await prodApi.GetObjectById("product", id);
            Product!.SetSingleItem(result);
        }
    }

    private async Task OnNameChanged(string? name)
    {
        _filter.Name = name;
        await Product!.Paginate(_filter);
    }

    private async Task OnCategoryChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int id))
            _filter.CategoryId = id;
        else
            _filter.CategoryId = null;

        await Product!.Paginate(_filter);
    }

    private async Task Filtering(ProductOrderByFilter orderBy)
    {
        if (_filter.OrderBy == orderBy)
            _filter.Descending = !_filter.Descending;
        else
        {
            _filter.OrderBy = orderBy;
            _filter.Descending = true;
        }

        await Product!.Paginate(_filter);
    }

    private void ToggleRotate()
    {
        isRotated = !isRotated;
    }
}
