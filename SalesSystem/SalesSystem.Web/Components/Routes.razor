@using SalesSystem.Web.Components.Pages
<CascadingAuthenticationState>
    <Router AppAssembly="typeof(Program).Assembly">
        <Found Context="routeData">

            <AuthorizeRouteView RouteData="routeData"
                                DefaultLayout="typeof(Layout.MainLayout)">

                <NotAuthorized>
                     @*
                         Verifies if User have the correct role using authentication
                     *@
                    <AuthorizeView Context="auth">
                        @*
                            If user authenticated, but don't have required role, show Not Authorized
                        *@
                        <Authorized>
                            <NotAuthorized/>
                        </Authorized>
                        @*
                            If user not authenticated, redirect to login
                        *@
                        <NotAuthorized>
                            <RedirectToLogin />
                        </NotAuthorized>
                    </AuthorizeView>

                </NotAuthorized>

                <Authorizing>
                    <p>Checking authorization...</p>
                </Authorizing>

            </AuthorizeRouteView>

            <FocusOnNavigate RouteData="routeData" Selector="h1" />

        </Found>

        <NotFound>
            <LayoutView Layout="@typeof(Layout.MainLayout)">
                <p>Page not found</p>
            </LayoutView>
        </NotFound>

    </Router>
</CascadingAuthenticationState>