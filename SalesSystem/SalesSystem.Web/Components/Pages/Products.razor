@page "/products"
@inject BaseApiService<GetProductDto> productApi
@inject BaseApiService<GetCategoryDto> categoryApi
@attribute [Authorize(Roles = Roles.AdminOrEmployee)]


<AuthorizeView Roles=@Roles.AdminOrEmployee>
    <Authorized>
        @if (_paginationService?.Data is null)
        {
            <p>Loading...</p>
        }
        else
        {
            <ProductsTable 
                Product="_paginationService"
                Category="_categories"/>
        }
    </Authorized>
    <NotAuthorized>
        <RedirectToLogin />
    </NotAuthorized>
</AuthorizeView>

@code {
    int pageSize = 20; // Products per page
    private PaginationService<GetProductDto>? _paginationService;
    private PagedResult<GetCategoryDto> _categories = null!;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _categories = await categoryApi.GetObjectPagedListAsync
            (
                "productcategory",
                0,
                50
            );

            _paginationService = new
            (
              productApi,
              "product",
              pageSize
            );
            await _paginationService.Paginate();
        }
        catch (Exception ex) { Console.WriteLine($"An error has occurred: {ex.Message}"); }
    }
}
