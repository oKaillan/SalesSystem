@page "/products"
@using SalesSystem.Shared.Database.Responses
@inject BaseApiService<GetProductDto> api
@attribute [Authorize(Roles = Roles.AdminOrEmployee)]


<AuthorizeView Roles=@Roles.AdminOrEmployee>
    <Authorized>
        @if (_paginationService?.Data is null)
        {
            <p>Loading...</p>
        }
        else
        {
            <div class="table-container">
                <table>
                    <thead>
                        <tr>
                            <th class="add-field"></th>
                            <th class="id-field">iD</th>
                            <th class="name-field">Name</th>
                            <th class="qtd-field">Quantity</th>
                            <th class="price-field">Price</th>
                            <th class="category-field">Categories</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var product in _paginationService.Data)
                        {
                            <tr>
                                <td class="add-field">
                                    <a class="add-button" href="/">
                                        <svg class="add-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640">
                                            <path d="M352 128C352 110.3 337.7 96 320 96C302.3 96 288 110.3 288 128L288 288L128 288C110.3 288 96 302.3 96 320C96 337.7 110.3 352 128 352L288 352L288 512C288 529.7 302.3 544 320 544C337.7 544 352 529.7 352 512L352 352L512 352C529.7 352 544 337.7 544 320C544 302.3 529.7 288 512 288L352 288L352 128z" />
                                        </svg>
                                    </a>
                                </td>
                                <td class="id-field">@product.Id</td>
                                <td class="name-field">@product.Name</td>
                                <td class="qtd-field">@product.Quantity</td>
                                <td class="price-field">@String.Format($"{product.Price:C}")</td>
                                <td class="category-field">
                                    @*Separates Categories using ,*@
                                    @string.Join(", ", product.Categories.Select(p => p.Name))
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                <div class="arrow-button-field">
                    <img id="left-arrow" src="/img/svg/arrow-button.svg"
                         @onclick="_paginationService.PreviousPageAsync" />
                    <input id="page-counter" type="number"
                           value="@_paginationService.PageNumber"
                           @onchange="_paginationService.GoToPageNumberAsync" />
                    <img id="right-arrow" src="/img/svg/arrow-button.svg"
                         @onclick="_paginationService.NextPageAsync" />
                </div>

            </div>
        }
    </Authorized>
    <NotAuthorized>
        <RedirectToLogin />
    </NotAuthorized>
</AuthorizeView>

@code {
    int pageSize = 20; // Products per page
    private PaginationService<GetProductDto>? _paginationService;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _paginationService = new(
              api,
              "product",
              pageSize
            );
            await _paginationService.Paginate();
        } 
        catch (Exception ex) { Console.WriteLine($"An error has occurred: {ex.Message}"); }
    }


}
