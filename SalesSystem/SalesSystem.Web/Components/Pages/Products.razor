@page "/products"
@inject BaseApiService<GetProductDto> api

<AuthorizeView Roles=@Roles.AdminOrEmployee>
    <Authorized>
        @if (products is null)
        {
            <p>Loading...</p>
        }
        else
        {
            <div class="table-container">
                <table>
                    <thead>
                        <tr>
                            <th class="add-field"></th>
                            <th class="id-field">iD</th>
                            <th class="name-field">Name</th>
                            <th class="qtd-field">Quantity</th>
                            <th class="price-field">Price</th>
                            <th class="category-field">Categories</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var product in products)
                        {
                            <tr>
                                <td class="add-field">
                                    <a class="add-button" href="/">
                                        <svg class="add-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640">
                                            <path d="M352 128C352 110.3 337.7 96 320 96C302.3 96 288 110.3 288 128L288 288L128 288C110.3 288 96 302.3 96 320C96 337.7 110.3 352 128 352L288 352L288 512C288 529.7 302.3 544 320 544C337.7 544 352 529.7 352 512L352 352L512 352C529.7 352 544 337.7 544 320C544 302.3 529.7 288 512 288L352 288L352 128z" />
                                        </svg>
                                    </a>
                                </td>
                                <td class="id-field">@product.Id</td>
                                <td class="name-field">@product.Name</td>
                                <td class="qtd-field">@product.Quantity</td>
                                <td class="price-field">@String.Format($"{product.Price:C}")</td>
                                <td class="category-field">
                                    @*Separates Categories using ,*@
                                    @string.Join(", ", product.Categories)
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </Authorized>
    <NotAuthorized>
        <RedirectToLogin/>
    </NotAuthorized>
</AuthorizeView>

@code {
    ICollection<GetProductDto>? products { get; set; }
    protected override async Task OnInitializedAsync()
    {
        products = await api.GetObjectListAsync("product");
    }
}
